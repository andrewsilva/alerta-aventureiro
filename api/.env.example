# Copie este arquivo para .env e preencha com os seus valores. Nunca versione o .env.
# String de conexão do PostgreSQL (ex.: banco do Neon). Use sslmode=require em bancos na nuvem.
DATABASE_URL="postgresql://usuario:senha@host:5432/alerta?sslmode=require"
# Banco SEPARADO usado só pelos testes automatizados (os testes apagam os dados dele).
DATABASE_URL_TEST="postgresql://usuario:senha@host:5432/alerta_test?sslmode=require"
# Chave para assinar os tokens JWT. Gere uma longa e aleatória.
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"
# Domínio do front-end autorizado no CORS
CORS_ORIGIN="http://localhost:4200"
PORT=3000
# Limites do bairro Aventureiro (latitude e longitude)
BAIRRO_LAT_MIN=-26.290
BAIRRO_LAT_MAX=-26.225
BAIRRO_LNG_MIN=-48.845
BAIRRO_LNG_MAX=-48.775
